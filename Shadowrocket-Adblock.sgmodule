#!name=墨鱼去广告（Shadowrocket）
#!desc=拦截广告域名和已知广告请求，HTTPS 路径规则需要启用 HTTPS 解密。
#!author=ddgksf2013
# 规则来源：本仓库 Adblock.sgmodule

[Rule]
